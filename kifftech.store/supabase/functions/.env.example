# Secrets Supabase Edge Functions (à définir dans Supabase Dashboard → Edge Functions → Secrets)
# NE PAS committer de valeurs réelles. Exemples FICTIFS uniquement.

# PayPal (mode Live production)
PAYPAL_CLIENT_ID=EXEMPLE_CLIENT_ID_FICTIF_LIVE
PAYPAL_CLIENT_SECRET=EXEMPLE_CLIENT_SECRET_FICTIF_LIVE
PAYPAL_API_BASE=https://api-m.paypal.com

# CORS : origine exacte du site publié (sans slash final)
# Exemple (domaine personnalisé) : https://www.example-published-site.tld
# Exemple (GitHub Pages)       : https://votre-utilisateur.github.io
PUBLIC_SITE_ORIGIN=https://exemple-origine-publiee.example
