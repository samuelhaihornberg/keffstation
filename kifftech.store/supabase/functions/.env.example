# ===================================================================================
# EXEMPLE FICTIF — aucune vraie valeur ici. Ne jamais committer de valeurs réelles.
# Les valeurs réelles sont saisies dans :
#   Supabase Dashboard → Edge Functions → Secrets  (ou : supabase secrets set NOM=valeur)
# ===================================================================================

# PayPal — mode Live (production)
PAYPAL_CLIENT_ID=EXEMPLE_CLIENT_ID_NON_REEL
PAYPAL_CLIENT_SECRET=EXEMPLE_SECRET_NON_REEL
PAYPAL_API_BASE=https://api-m.paypal.com

# Origine exacte du site publié (CORS + refus des appels d'autres sites), sans slash final
PUBLIC_SITE_ORIGIN=https://exemple.invalid

# NE PAS CRÉER : SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY sont fournis
# automatiquement par l'environnement des Edge Functions. Aucun secret préfixé SUPABASE_ n'est nécessaire.
