# Backend PayPal (ne jamais exposer le secret côté navigateur / dépôt)
# Ces variables doivent être configurées dans l’environnement d’hébergement du backend.

# Identifiants Sandbox OU Live (selon l’environnement ciblé)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Base API PayPal :
# - Sandbox : https://api-m.sandbox.paypal.com
# - Live    : https://api-m.paypal.com
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# Port local du serveur Node (server.js) si utilisé
PORT=3000
