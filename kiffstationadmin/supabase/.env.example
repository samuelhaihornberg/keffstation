# Noms des secrets à définir dans Supabase → Edge Functions → Secrets.
# Ne jamais commiter de vraie valeur.

# Chaîne aléatoire longue (32 octets hexadécimaux minimum), stockée dans Bitwarden.
SESSION_PEPPER=

# Origines autorisées à appeler /ingest, séparées par des virgules.
# Exemple : https://keffstation.com,https://www.keffstation.com
ALLOWED_ORIGINS=
